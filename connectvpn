#!/usr/bin/env python3
"""Developer-friendly wrapper for the local source tree."""

from pathlib import Path
import sys


ROOT = Path(__file__).resolve().parent
SRC = ROOT / "src"
if SRC.exists():
    sys.path.insert(0, str(SRC))

from connectvpn.app import main


if __name__ == "__main__":
    raise SystemExit(main())
